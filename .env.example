# KalaKriti Arts Studio - Environment Variable Configuration Template

# Database File Path (Defaults to local store.db)
DATABASE_FILE=store.db

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Payment Gateway Configuration (Razorpay)
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecretKey456
ALLOW_SIMULATED_PAYMENTS=true

# Store Configuration
STORE_URL=http://localhost:3000
